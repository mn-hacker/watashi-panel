msgstr "Сначала выполните это на иранском сервере:"

msgid "Then build the Kharej side here on this panel."
msgstr "Затем соберите сторону Хареджа здесь, в этой панели."

msgid "Starts on boot"
msgstr "Запускается при загрузке"

msgid "Does not start on boot"
msgstr "Не запускается при загрузке"

msgid "Turn the tunnel on or off"
msgstr "Включить или выключить туннель"

msgid "Show the token"
msgstr "Показать токен"

msgid "Copy the token"
msgstr "Скопировать токен"

msgid "Delete this tunnel"
msgstr "Удалить этот туннель"

msgid "No tunnel has been built yet."
msgstr "Туннелей пока не построено."

