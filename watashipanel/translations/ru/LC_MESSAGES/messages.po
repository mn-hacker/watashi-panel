msgstr "Создайте первый зелёной кнопкой вверху страницы."

msgid "Turn every tunnel on"
msgstr "Включить все туннели"

msgid "Turn every tunnel off"
msgstr "Выключить все туннели"

msgid "Keep it the same on both sides."
msgstr "С обеих сторон должно быть одинаково."

msgid "Send small packets without waiting."
msgstr "Отправлять маленькие пакеты без ожидания."

msgid "Keep the line warm so it does not fall asleep."
msgstr "Держать канал «тёплым», чтобы он не заснул."

msgid "Listen on IPv6 as well."
msgstr "Слушать также на IPv6."

msgid "The tunnel starts by itself once it is saved."
msgstr "Туннель запустится сам сразу после сохранения."

msgid "Build the tunnel"
msgstr "Построить туннель"

msgid "Token"
msgstr "Токен"

msgid "Total Tunnels"
msgstr "Всего туннелей"

msgid "It was copied."
msgstr "Скопировано."

msgid "It could not be copied. Copy it by hand."
msgstr "Не удалось скопировать, скопируйте вручную."

msgid "The panel did not answer."
msgstr "Панель не ответила."

msgid "This address is not open on this panel."
msgstr "Этот адрес не открыт на этой панели."

msgid "Something did not go through."
msgstr "Что-то не прошло."

msgid "It is done."
msgstr "Готово."

msgid "Working..."
msgstr "Работаю..."

msgid "Yes, go ahead"
msgstr "Да, продолжай"

msgid "Build the Iran side"
msgstr "Построить сторону Ирана"

msgid "Build the Kharej side"
msgstr "Построить сторону Хареджа"

msgid "Saving means the tunnel is built again, so it goes quiet for a moment."
msgstr "Сохранение означает пересборку туннеля, поэтому он на минуту замолчит."

msgid "The address of the Iran server has to be filled in."
msgstr "Нужно указать адрес иранского сервера."

msgid "The tunnel port has to be filled in."
msgstr "Нужно указать порт туннеля."

msgid "A port has to be a number between 1024 and 65535."
msgstr "Порт должен быть числом от 1024 до 65535."

msgid "The ports to forward have to be filled in."
msgstr "Нужно указать порты для проброса."

msgid "The tunnel is on now."
msgstr "Туннель включён."

msgid "The tunnel is off now."
msgstr "Туннель выключен."

msgid "Restart this tunnel?"
msgstr "Перезапустить этот туннель?"

